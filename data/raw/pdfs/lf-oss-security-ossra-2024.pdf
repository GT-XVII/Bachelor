            .unified-hexagon {
                position: absolute !important;
                left: 50% !important;
                top: 50% !important;
                z-index: 200 !important;
            }

            .unified-hexagon.breathing {
                -webkit-animation: appearCloudTablet 0.7s 2s ease-out forwards,
                    breatheCloudTablet 3s 2.5s ease-in-out infinite;
                        animation: appearCloudTablet 0.7s 2s ease-out forwards,
                    breatheCloudTablet 3s 2.5s ease-in-out infinite;
            }

