                opacity: 1;
            }

            80% {
                -webkit-transform: translate(-50%, -50%) scale(0.5);
                        transform: translate(-50%, -50%) scale(0.5);
                opacity: 0.3;
            }

            90% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }

            100% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }
        }

        /* Integration - 300° (top-left) */
        @-webkit-keyframes completeAnimationIntegration {
            0% {
                -webkit-transform: translate(-223px, -150px) scale(0);
                        transform: translate(-223px, -150px) scale(0);
                opacity: 0;
            }

            14.3% {
                -webkit-transform: translate(-223px, -150px) scale(1);
                        transform: translate(-223px, -150px) scale(1);
                opacity: 1;
            }

            18% {
                -webkit-transform: translate(-223px, -150px) scale(1);
                        transform: translate(-223px, -150px) scale(1);
                opacity: 1;
            }

            80% {
                -webkit-transform: translate(-50%, -50%) scale(0.5);
                        transform: translate(-50%, -50%) scale(0.5);
                opacity: 0.3;
            }

            90% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }

            100% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }
        }
        @keyframes completeAnimationIntegration {
            0% {
                -webkit-transform: translate(-223px, -150px) scale(0);
                        transform: translate(-223px, -150px) scale(0);
                opacity: 0;
            }

            14.3% {
                -webkit-transform: translate(-223px, -150px) scale(1);
                        transform: translate(-223px, -150px) scale(1);
                opacity: 1;
            }

            18% {
                -webkit-transform: translate(-223px, -150px) scale(1);
                        transform: translate(-223px, -150px) scale(1);
                opacity: 1;
            }

            80% {
                -webkit-transform: translate(-50%, -50%) scale(0.5);
                        transform: translate(-50%, -50%) scale(0.5);
                opacity: 0.3;
            }

            90% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }

            100% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }
        }

        /* Connection Lines */
        .connection-lines {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        /* CONNECTION LINES - Behind circles */
        .connection-line {
            position: absolute;
            height: 2px;
            background: -o-linear-gradient(left, rgba(253, 185, 19, 0) 0%, rgba(253, 185, 19, 0.8) 50%, rgba(253, 185, 19, 0) 100%);
            background: -webkit-gradient(linear, left top, right top, from(rgba(253, 185, 19, 0)), color-stop(50%, rgba(253, 185, 19, 0.8)), to(rgba(253, 185, 19, 0)));
            background: linear-gradient(90deg, rgba(253, 185, 19, 0) 0%, rgba(253, 185, 19, 0.8) 50%, rgba(253, 185, 19, 0) 100%);
            -webkit-transform-origin: left center;
                -ms-transform-origin: left center;
                    transform-origin: left center;
            opacity: 0;
            z-index: 0;
            -webkit-animation: glowLine 0.3s 0.6s ease-out forwards;
                    animation: glowLine 0.3s 0.6s ease-out forwards;
        }

        /* Line from Code (top) to AI (top-right) */
        .line-1 {
            top: 50%;
            left: 50%;
            width: 200px;
            -webkit-transform: translate(-50%, -200px) rotate(30deg);
                -ms-transform: translate(-50%, -200px) rotate(30deg);
                    transform: translate(-50%, -200px) rotate(30deg);
        }

        /* Line from AI (top-right) to Dependency (bottom-right) */
        .line-2 {
            top: 50%;
            left: 50%;
            width: 200px;
            -webkit-transform: translate(123px, -150px) rotate(90deg);
                -ms-transform: translate(123px, -150px) rotate(90deg);
                    transform: translate(123px, -150px) rotate(90deg);
        }

        /* Line from Dependency (bottom-right) to Prioritization (bottom) */
        .line-3 {
            top: 50%;
            left: 50%;
            width: 200px;
            -webkit-transform: translate(123px, 50px) rotate(150deg);
                -ms-transform: translate(123px, 50px) rotate(150deg);
                    transform: translate(123px, 50px) rotate(150deg);
        }

        /* Line from Prioritization (bottom) to Devops (bottom-left) */
        .line-4 {
            top: 50%;
            left: 50%;
            width: 200px;
            -webkit-transform: translate(-50%, 150px) rotate(210deg);
                -ms-transform: translate(-50%, 150px) rotate(210deg);
                    transform: translate(-50%, 150px) rotate(210deg);
        }

        /* Line from Devops (bottom-left) to Integration (top-left) */
        .line-5 {
            top: 50%;
            left: 50%;
            width: 200px;
            -webkit-transform: translate(-223px, 50px) rotate(270deg);
                -ms-transform: translate(-223px, 50px) rotate(270deg);
                    transform: translate(-223px, 50px) rotate(270deg);
        }

        /* Line from Integration (top-left) to Code (top) */
        .line-6 {
            top: 50%;
            left: 50%;
            width: 200px;
            -webkit-transform: translate(-223px, -150px) rotate(330deg);
                -ms-transform: translate(-223px, -150px) rotate(330deg);
                    transform: translate(-223px, -150px) rotate(330deg);
        }

        /* Hide labels during merge */
        .floating-element.merging .element-label {
            -webkit-animation: fadeOutLabel 0.5s 2.9s ease-out forwards;
                    animation: fadeOutLabel 0.5s 2.9s ease-out forwards;
        }

        @-webkit-keyframes fadeOutLabel {
            to {
                opacity: 0;
            }
        }

        @keyframes fadeOutLabel {
            to {
                opacity: 0;
            }
        }

        /* Unified Cloud Icon */
        .unified-hexagon {
            position: absolute;
            top: 50%;
            left: 50%;
            -webkit-transform: translate(-50%, -50%) scale(0);
                -ms-transform: translate(-50%, -50%) scale(0);
                    transform: translate(-50%, -50%) scale(0);
            opacity: 0;
            -webkit-animation: appearCloud 0.7s 1s ease-out forwards;
                    animation: appearCloud 0.7s 1s ease-out forwards;
            color: #3e1d59;
            -webkit-filter: drop-shadow(0 0 30px rgba(253, 185, 19, 0.4));
                    filter: drop-shadow(0 0 30px rgba(253, 185, 19, 0.4));
            z-index: 200;
        }

        .unified-hexagon i {
            display: block;
        }

        .cloud-svg {
            width: 600px;
            height: auto;
            color: #5a2a82;
            display: block;
            opacity: 0.98;
            -webkit-filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.45));
                    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.45));
            stroke-width: 4;
            stroke: url(#cloudGradient);
        }

        .hexagon-icons {
            position: absolute;
            width: 520px;
            height: 326px;
            top: 50%;
            left: 50%;
            -webkit-transform: translate(-50%, -50%);
                -ms-transform: translate(-50%, -50%);
                    transform: translate(-50%, -50%);
            pointer-events: all;
        }

        @-webkit-keyframes appearCloud {
            0% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
            }

            100% {
                -webkit-transform: translate(-50%, -50%) scale(1);
                        transform: translate(-50%, -50%) scale(1);
                opacity: 1;
            }
        }

        @keyframes appearCloud {
            0% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
            }

            100% {
                -webkit-transform: translate(-50%, -50%) scale(1);
                        transform: translate(-50%, -50%) scale(1);
                opacity: 1;
            }
        }

        /* Cloud Breathing */
        .unified-hexagon.breathing {
            -webkit-animation: appearCloud 0.7s 2s ease-out forwards,
                breatheCloud 3s 2.5s ease-in-out infinite;
                    animation: appearCloud 0.7s 2s ease-out forwards,
                breatheCloud 3s 2.5s ease-in-out infinite;
            z-index: 200;
            position: relative;
        }

        @-webkit-keyframes breatheCloud {

            0%,
            100% {
                -webkit-transform: translate(-50%, -50%) scale(1);
                        transform: translate(-50%, -50%) scale(1);
                text-shadow:
                    0 0 30px rgba(253, 185, 19, 0.2),
                    0 0 60px rgba(253, 185, 19, 0.1),
                    0 5px 20px rgba(0, 0, 0, 0.2);
            }

            50% {
                -webkit-transform: translate(-50%, -50%) scale(1.04);
                        transform: translate(-50%, -50%) scale(1.04);
                text-shadow:
                    0 0 40px rgba(253, 185, 19, 0.3),
                    0 0 70px rgba(253, 185, 19, 0.2),
                    0 5px 22px rgba(0, 0, 0, 0.3);
            }
        }

        @keyframes breatheCloud {

            0%,
            100% {
                -webkit-transform: translate(-50%, -50%) scale(1);
                        transform: translate(-50%, -50%) scale(1);
                text-shadow:
                    0 0 30px rgba(253, 185, 19, 0.2),
                    0 0 60px rgba(253, 185, 19, 0.1),
                    0 5px 20px rgba(0, 0, 0, 0.2);
            }

            50% {
                -webkit-transform: translate(-50%, -50%) scale(1.04);
                        transform: translate(-50%, -50%) scale(1.04);
                text-shadow:
                    0 0 40px rgba(253, 185, 19, 0.3),
                    0 0 70px rgba(253, 185, 19, 0.2),
                    0 5px 22px rgba(0, 0, 0, 0.3);
            }
        }

        /* Icons inside Cloud - Centered vertically and horizontally */
        .hexagon-icon {
            position: absolute;
            font-size: 32px;
            opacity: 0;
            z-index: 10;
            -webkit-filter: none;
                    filter: none;
            text-shadow: none;
            -webkit-transition: color 0.8s ease-in-out;
            -o-transition: color 0.8s ease-in-out;
            transition: color 0.8s ease-in-out;
        }

        /* Icon 1 - Code (top left)- code icon*/
        .hexagon-icon:nth-child(1) {
            top: 40%;
            left: 25%;
            -webkit-animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon1 3s 2.5s ease-in-out infinite,
                colorCycleOrange1 7s 2.5s linear infinite;
                    animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon1 3s 2.5s ease-in-out infinite,
                colorCycleOrange1 7s 2.5s linear infinite;
        }

        /* Icon 2 - AI (top center) - brain icon*/
        .hexagon-icon:nth-child(2) {
            top: 8%;
            left: 38%;
            -webkit-transform: translateX(-50%);
                -ms-transform: translateX(-50%);
                    transform: translateX(-50%);
            -webkit-animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon2 3s 2.5s ease-in-out infinite,
                colorCycleOrange2 7s 2.5s linear infinite;
                    animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon2 3s 2.5s ease-in-out infinite,
                colorCycleOrange2 7s 2.5s linear infinite;
        }

        /* Icon 3 - Dependency (top right) - cubes icon */
        .hexagon-icon:nth-child(3) {
            top: 23%;
            right: 22%;
            -webkit-animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon3 3s 2.5s ease-in-out infinite,
                colorCycleOrange3 7s 2.5s linear infinite;
                    animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon3 3s 2.5s ease-in-out infinite,
                colorCycleOrange3 7s 2.5s linear infinite;
        }

        /* Icon 4 - Prioritization (bottom right) sort icon*/
        .hexagon-icon:nth-child(4) {
            bottom: 5%;
            right: 8%;
            -webkit-animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon4 3s 2.5s ease-in-out infinite,
                colorCycleOrange4 7s 2.5s linear infinite;
                    animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon4 3s 2.5s ease-in-out infinite,
                colorCycleOrange4 7s 2.5s linear infinite;
        }

        /* Icon 5 - Devops (bottom center)- infinite icon */
        .hexagon-icon:nth-child(5) {
            bottom: 17%;
            left: 56%;
            -webkit-transform: translateX(-50%);
                -ms-transform: translateX(-50%);
                    transform: translateX(-50%);
            -webkit-animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon5 3s 2.5s ease-in-out infinite,
                colorCycleOrange5 7s 2.5s linear infinite;
                    animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon5 3s 2.5s ease-in-out infinite,
                colorCycleOrange5 7s 2.5s linear infinite;
        }

        /* Icon 6 - Integration (bottom left) - plug icon*/
        .hexagon-icon:nth-child(6) {
            bottom: 9%;
            left: 11%;
            -webkit-animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon6 3s 2.5s ease-in-out infinite,
                colorCycleOrange6 7s 2.5s linear infinite;
                    animation: opacityPulseGroup1 2s 1.8s ease-in-out forwards,
                pulseIcon6 3s 2.5s ease-in-out infinite,
                colorCycleOrange6 7s 2.5s linear infinite;
        }

        /* Fade in animation - smooth gradual fade with cloud */
        @-webkit-keyframes fadeInStatic {
