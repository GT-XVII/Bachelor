        /* Opacity alternation - Group 1 (icons 1-3): smooth fade in then stay visible */
        @-webkit-keyframes opacityPulseGroup1 {
            0% {
                opacity: 0;
            }

            50% {
                opacity: 1;
            }

            50%,
            100% {
                opacity: 1;
