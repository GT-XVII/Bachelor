        /* Complete Animations - Scale up + Brief Pause + Pull + Fade */
        /* Circular arrangement with 60-degree spacing between 6 icons */

        /* Code - 0° (top) */
        @-webkit-keyframes completeAnimationCode {
            0% {
                -webkit-transform: translate(-50%, -200px) scale(0);
                        transform: translate(-50%, -200px) scale(0);
                opacity: 0;
            }

            14.3% {
                -webkit-transform: translate(-50%, -200px) scale(1);
                        transform: translate(-50%, -200px) scale(1);
                opacity: 1;
            }

            18% {
                -webkit-transform: translate(-50%, -200px) scale(1);
                        transform: translate(-50%, -200px) scale(1);
                opacity: 1;
            }

            80% {
                -webkit-transform: translate(-50%, -50%) scale(0.5);
                        transform: translate(-50%, -50%) scale(0.5);
                opacity: 0.3;
            }

            90% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }

            100% {
                -webkit-transform: translate(-50%, -50%) scale(0);
                        transform: translate(-50%, -50%) scale(0);
                opacity: 0;
                visibility: hidden;
            }
        }
