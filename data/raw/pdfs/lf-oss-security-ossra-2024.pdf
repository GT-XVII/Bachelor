        /* ========================================
           RESPONSIVE DESIGN - MOBILE (375px - 729px)
           Smaller elements, hidden background shapes
           ======================================== */
        @media (max-width: 729px) {

            /* Hide background shapes on mobile */
            .depth-shape {
                display: none !important;
            }

            .hero-banner2 {
                min-height: auto;
                padding: 30px 0 0;
                display: -webkit-box;
                display: -ms-flexbox;
                display: flex;
                -webkit-box-orient: vertical;
                -webkit-box-direction: normal;
                    -ms-flex-direction: column;
                        flex-direction: column;
            }
            .text-content .eyebrow {
                font-size: 16px!important;
            }

            .banner-content {
                -webkit-box-orient: vertical;
                -webkit-box-direction: normal;
                    -ms-flex-direction: column;
                        flex-direction: column;
                gap: 40px;
                width: 100%;
                -webkit-box-align: center;
                    -ms-flex-align: center;
                        align-items: center;
            }

            .text-content {
                max-width: 100%;
                width: 100%;
                text-align: center;
                -ms-flex-negative: 0;
                    flex-shrink: 0;
            }

            .text-content::before {
                left: 50%;
                -webkit-transform: translateX(-50%);
                    -ms-transform: translateX(-50%);
                        transform: translateX(-50%);
                width: 80px;
                height: 3px;
            }

            .headline .main {
                font-size: 48px;
            }

            .headline .white {
                font-size: 24px;
            }

            .subheadline {
                font-size: 14px;
                margin-top: 20px;
            }

            .button-row::after {
                margin: 50px auto 0;
            }

            .subheadline::after {
                width: 60px;
                margin-top: 30px;
                margin-left: auto;
                margin-right: auto;
            }

            .animation-container {
                height: 280px !important;
                min-height: 280px !important;
                width: 100%;
                display: -webkit-box;
                display: -ms-flexbox;
                display: flex;
                -webkit-box-align: center;
                    -ms-flex-align: center;
                        align-items: center;
                -webkit-box-pack: center;
                    -ms-flex-pack: center;
                        justify-content: center;
                position: relative;
                overflow: visible;
                margin-top: 0;
                -webkit-box-flex: 0 !important;
                    -ms-flex: 0 0 280px !important;
                        flex: 0 0 280px !important
            }

            .floating-element {
                width: 70px;
                height: 70px;
                padding: 10px;
            }

            .element-icon {
                font-size: 20px;
            }

            .element-label {
                font-size: 7px;
                letter-spacing: 0.3px;
            }

            /* Ensure cloud is centered on mobile */
            .unified-hexagon {
                position: absolute !important;
                left: 50% !important;
                top: 50% !important;
                margin-top: 0 !important;
                z-index: 200 !important;
            }

            .unified-hexagon.breathing {
                -webkit-animation: appearCloudMobile 0.7s 2s ease-out forwards,
                    breatheCloudMobile 3s 2.5s ease-in-out infinite;
                        animation: appearCloudMobile 0.7s 2s ease-out forwards,
                    breatheCloudMobile 3s 2.5s ease-in-out infinite;
            }

            @-webkit-keyframes appearCloudMobile {
                0% {
                    -webkit-transform: translate(-50%, -50%) scale(0);
                            transform: translate(-50%, -50%) scale(0);
                    opacity: 0;
                }

                100% {
                    -webkit-transform: translate(-50%, -50%) scale(1);
                            transform: translate(-50%, -50%) scale(1);
                    opacity: 1;
                }
            }

            @keyframes appearCloudMobile {
                0% {
