<script type="text/javascript">

    function OptanonWrapper() {
        var activeGroups = window.OnetrustActiveGroups || '';

        console.log('OneTrust Active Groups:', activeGroups);

        // Check if user has interacted with the banner
        var hasInteracted = document.cookie.match('(^|;)\\s*OptanonAlertBoxClosed\\s*=\\s*([^;]+)') !== null;

        if (!hasInteracted) {

            console.log('User has not interacted with banner - no consent update needed');
            return;
        }

        // User HAS interacted with banner
        // Update consent based on their choices
        console.log('User interacted with banner - updating consent');

        var consentMap = {
            // Analytics (C0002)
            'analytics_storage': activeGroups.indexOf('C0002') !== -1 ? 'granted' : 'denied',
            // Advertising (C0004)
            'ad_storage': activeGroups.indexOf('C0004') !== -1 ? 'granted' : 'denied',
            'ad_user_data': activeGroups.indexOf('C0004') !== -1 ? 'granted' : 'denied',
            'ad_personalization': activeGroups.indexOf('C0004') !== -1 ? 'granted' : 'denied',
            // Functional (C0003)
            'functionality_storage': activeGroups.indexOf('C0003') !== -1 ? 'granted' : 'denied',
            'personalization_storage': activeGroups.indexOf('C0003') !== -1 ? 'granted' : 'denied'
            // Note: security_storage is always 'granted' (set in defaults, not updated here)
        };

        console.log('Updating consent:', consentMap);

        gtag('consent', 'update', consentMap);

        window.dataLayer.push({
            'event': 'onetrust_consent_update',
            'consent_state': consentMap,
            'onetrust_groups': activeGroups,
            'consent_method': 'user_interaction'
        });
    }
</script>


	
