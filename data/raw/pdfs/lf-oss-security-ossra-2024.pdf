        /* ========================================
           RESPONSIVE DESIGN - TABLET (730px - 991px)
           Medium-sized elements, reduced opacity
           ======================================== */
        @media (min-width: 730px) and (max-width: 991px) {

            /* Reduce background shape opacity */
            .depth-shape.layer-1 {
                opacity: 0.15;
            }

            .depth-shape.layer-2 {
                opacity: 0.18;
            }

            .depth-shape.layer-3 {
                opacity: 0.12;
            }

            .hero-banner2 {
                min-height: auto;
                padding: 30px 0 0;
                -webkit-box-align: start;
                    -ms-flex-align: start;
                        align-items: flex-start;
            }

            .banner-content {
                -webkit-box-orient: vertical;
                -webkit-box-direction: normal;
                    -ms-flex-direction: column;
                        flex-direction: column;
                gap: 60px;
                -webkit-box-align: center;
                    -ms-flex-align: center;
                        align-items: center;
                width: 100%;
            }

            .text-content::before {
                left: 50%;
                -webkit-transform: translateX(-50%);
                    -ms-transform: translateX(-50%);
                        transform: translateX(-50%);
                width: 80px;
                height: 3px;
            }

            .button-row::after {
                margin: 50px auto 0;
            }

            .text-content {
                max-width: 100%;
                text-align: center;
            }

            .animation-container {
                height: 350px;
                width: 100%;
                display: -webkit-box;
                display: -ms-flexbox;
                display: flex;
                -webkit-box-align: center;
                    -ms-flex-align: center;
                        align-items: center;
                -webkit-box-pack: center;
                    -ms-flex-pack: center;
                        justify-content: center;
                margin-top: 0;
            }

            .floating-element {
                width: 95px;
                height: 95px;
                padding: 12px;
            }

            .element-icon {
                font-size: 24px;
            }

            .element-label {
                font-size: 9px;
            }

